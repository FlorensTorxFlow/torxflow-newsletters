{
  "publicBaseUrl": "https://torxflow-newsletters.empty-hill-4369.workers.dev",
  "cloudflare": {
    "assetsDirectory": "./public",
    "projectName": "torxflow-newsletters"
  },
  "standardAssets": {
    "headerPath": "public/assets/header/torxflow-news-header.png",
    "logoPath": "public/assets/logo/torxflow-mark.png",
    "headerUrl": "https://torxflow-newsletters.empty-hill-4369.workers.dev/assets/header/torxflow-news-header.png",
    "logoUrl": "https://torxflow-newsletters.empty-hill-4369.workers.dev/assets/logo/torxflow-mark.png"
  },
  "newsletterRun": {
    "rootPattern": "public/newsletter/YYYY-MM-DD",
    "imagesPattern": "public/newsletter/YYYY-MM-DD/images/article-N.jpg",
    "publicImageUrlPattern": "https://torxflow-newsletters.empty-hill-4369.workers.dev/newsletter/YYYY-MM-DD/images/article-N.jpg"
  },
  "articleImage": {
    "width": 1040,
    "height": 300,
    "emailDisplayWidth": 520,
    "emailDisplayHeight": 150,
    "aspectRatio": "3.47:1",
    "generationRule": "Generate as wide editorial newsletter banners; save raw image, then optimize/validate to final 1040x300 JPG before use in email HTML.",
    "format": "jpg",
    "preferredMaxBytes": 358400,
    "preferredSizeRangeKb": "200-350",
    "failurePolicy": "Run images:prepare once. If it fails, stop. Do not commit, push, fill template, or send email.",
    "prepareCommand": "npm.cmd run images:prepare -- YYYY-MM-DD"
  },
  "placeholders": {
    "articleImageUrls": [
      "{{ARTICLE_1_IMAGE_URL}}",
      "{{ARTICLE_2_IMAGE_URL}}",
      "{{ARTICLE_3_IMAGE_URL}}",
      "{{ARTICLE_4_IMAGE_URL}}",
      "{{ARTICLE_5_IMAGE_URL}}"
    ],
    "articleImageAlts": [
      "{{ARTICLE_1_IMAGE_ALT}}",
      "{{ARTICLE_2_IMAGE_ALT}}",
      "{{ARTICLE_3_IMAGE_ALT}}",
      "{{ARTICLE_4_IMAGE_ALT}}",
      "{{ARTICLE_5_IMAGE_ALT}}"
    ]
  },
  "template": {
    "path": "templates/torxflow-news-email-template.html",
    "renderCommand": "npm.cmd run email:render -- YYYY-MM-DD",
    "outputPattern": "public/newsletter/YYYY-MM-DD/email-preview.html",
    "dataPattern": "data/newsletter-runs/YYYY-MM-DD.json",
    "requiredNewsletterFields": [
      "title",
      "subtitle",
      "date",
      "readTime"
    ],
    "requiredArticleFields": [
      "index",
      "title",
      "summary",
      "imageAlt"
    ],
    "requiredTemplateTokens": [
      "{{NEWSLETTER_TITLE}}",
      "{{NEWSLETTER_SUBTITLE}}",
      "{{NEWSLETTER_DATE}}",
      "{{READ_TIME}}",
      "{{ARTICLE_1_TITLE}}",
      "{{ARTICLE_1_SUMMARY}}",
      "{{ARTICLE_1_IMAGE_URL}}",
      "{{ARTICLE_1_IMAGE_ALT}}",
      "{{ARTICLE_5_TITLE}}",
      "{{ARTICLE_5_SUMMARY}}",
      "{{ARTICLE_5_IMAGE_URL}}",
      "{{ARTICLE_5_IMAGE_ALT}}"
    ]
  }
}
